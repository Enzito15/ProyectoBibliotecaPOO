<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<VBox spacing="15.0" style="-fx-background-color: white"
      stylesheets="@style.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.proyect_final02.controller.ReservaFromController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>
    <children>
        <Label text="Nueva Reserva" textFill="#014074">
            <font>
                <Font name="System Bold" size="18.0"/>
            </font>
        </Label>
        <Separator prefWidth="200.0"/>
        <Label text="Libro y fechas" textFill="dimgray">
            <font>
                <Font name="System Bold" size="13.0"/>
            </font>
        </Label>
        <GridPane hgap="10.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="260.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label text="Libro"/>
                <ComboBox fx:id="cmbLibro" maxWidth="Infinity" promptText="Seleccione un libro" GridPane.columnIndex="1"/>
                <Label text="Fecha de alquiler" GridPane.rowIndex="1"/>
                <DatePicker fx:id="dpAlquiler" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Fecha de devolucion" GridPane.rowIndex="2"/>
                <DatePicker fx:id="dpDevolucion" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Total (S/)" GridPane.rowIndex="3"/>
                <TextField fx:id="txtTotal" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </children>
        </GridPane>
        <Label text="Datos del cliente" textFill="dimgray">
            <font>
                <Font name="System Bold" size="13.0"/>
            </font>
        </Label>
        <GridPane hgap="10.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="260.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label text="DNI"/>
                <TextField fx:id="txtDni" GridPane.columnIndex="1"/>
                <Label text="Nombre" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Apellidos" GridPane.rowIndex="2"/>
                <TextField fx:id="txtApellidos" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="EMAIL" GridPane.rowIndex="3"/>
                <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </children>
        </GridPane>
        <Label fx:id="lbClienteInfo" textFill="dimgray"/>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel"
                        prefHeight="31.0" prefWidth="100.0" styleClass="buttom-action-delete" text="Cancelar"/>
                <Button mnemonicParsing="false" onAction="#handleSave"
                        prefHeight="31.0" prefWidth="100.0" styleClass="buttom-action-edit" text="Guardar"/>
            </children>
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
        </HBox>
    </children>
</VBox>
