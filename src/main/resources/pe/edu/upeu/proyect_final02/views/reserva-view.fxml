<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: #F7F7F7;" stylesheets="@style.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.proyect_final02.controller.ReservaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Gestion del Alquiler de Libros" textFill="black">
                    <font>
                        <Font name="System Bold" size="20.0"/>
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" styleClass="button-login" onAction="#handleNew" text="+ Nueva reserva"/>
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <TextField fx:id="txtBuscar" promptText="Buscar por DNI, cliente o título..." onAction="#handleSearch" HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" styleClass="button-login" onAction="#handleSearch" text="Buscar"/>
                <Button mnemonicParsing="false" styleClass="button-login" onAction="#handleClear" text="Limpiar"/>
            </children>
        </HBox>
        <TableView fx:id="tableReserva" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="30.0" text="N"/>
                <TableColumn fx:id="ColCliente" prefWidth="150.0" text="Cliente"/>
                <TableColumn fx:id="ColDni" prefWidth="80.0" text="DNI"/>
                <TableColumn fx:id="ColLibro" prefWidth="150.0" text="Libro"/>
                <TableColumn fx:id="ColAlquiler" prefWidth="90.0" text="Alquiler"/>
                <TableColumn fx:id="ColDevolucion" prefWidth="90.0" text="Devolucion"/>
                <TableColumn fx:id="ColTotal" prefWidth="60.0" text="Total"/>
                <TableColumn fx:id="ColEstado" prefWidth="100.0" text="Estado"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <!--Botones-->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleDevolver" styleClass="button-action-edit" text="Marcar devuelto"/>
                <Button mnemonicParsing="false" onAction="#handleDelete" styleClass="button-action-delete" text="Eliminar"/>
            </children>
        </HBox>
    </children>
</VBox>


